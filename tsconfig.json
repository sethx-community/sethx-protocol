{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "hardhat", "mocha"],
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true
  },
  "include": [
    "./hardhat.config.ts",
    "./scripts",
    "./test",
    "./ignition",
    "./deploy",
    "./typechain-types"
  ]
}
