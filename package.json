{
  "license": "MIT",
  "name": "sethx-protocol",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:token": "hardhat test test/token",
    "node": "hardhat node",
    "clean": "hardhat clean",
    "deploy:local": "cross-env SETHX_DEPLOYMENT_ENVIRONMENT=local hardhat run scripts/run-deployment.ts --network localhost",
    "deploy:testnet": "cross-env SETHX_DEPLOYMENT_ENVIRONMENT=testnet hardhat run scripts/run-deployment.ts --network testnet",
    "deploy:mainnet": "cross-env SETHX_DEPLOYMENT_ENVIRONMENT=mainnet hardhat run scripts/run-deployment.ts --network mainnet",
    "test:local": "hardhat test --network localhost",
    "test:testnet": "hardhat test --network testnet",
    "test:mainnet": "hardhat test --network mainnet",
    "verify:token": "hardhat run scripts/verify/verify-token-distribution.ts --network localhost"
  },
  "dependencies": {
    "@chainlink/contracts": "^1.4.0",
    "@chainlink/local": "^0.2.2",
    "@openzeppelin/contracts": "^5.3.0",
    "@openzeppelin/contracts-upgradeable": "^5.3.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.8",
    "@nomicfoundation/hardhat-ignition": "^3.0.7",
    "@nomicfoundation/hardhat-ignition-ethers": "^3.0.7",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.2",
    "@types/mocha": "^10.0.10",
    "chai": "^5.2.0",
    "chai-as-promised": "^8.0.1",
    "cross-env": "^10.1.0",
    "ethers": "^6.16.0",
    "hardhat": "^3.1.6",
    "prettier": "^3.6.2",
    "prettier-plugin-solidity": "^2.1.0",
    "typescript": "^5.2.2"
  }
}
